# Supabase (client-safe keys only — never commit service role keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local dev: skip real OTP email delivery; uses anonymous sign-in for sessions.
# Requires Anonymous sign-ins enabled in Supabase Dashboard → Authentication → Providers.
EXPO_PUBLIC_AUTH_DEV_BYPASS=true
