# Supabase (client-safe keys only — never commit service role keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local dev: skip real OTP email delivery; uses in-memory dev sessions (no Supabase anonymous sign-in).
# Only active when __DEV__ is true. Set to false or remove for production builds.
EXPO_PUBLIC_AUTH_DEV_BYPASS=true
