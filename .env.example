# Supabase (client-safe keys only — never commit service role keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local dev: skip real OTP email delivery; uses in-memory dev sessions (no Supabase anonymous sign-in).
# Only active when __DEV__ is true. MUST be false to test real user_profiles writes/reads.
# Set to false or remove for production builds.
EXPO_PUBLIC_AUTH_DEV_BYPASS=false

# Optional: enable verbose profile/auth debug logging in development.
EXPO_PUBLIC_PROFILE_DEBUG=false
