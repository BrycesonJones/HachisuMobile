# Supabase Edge Function secrets — SERVER SIDE ONLY.
#
# The BTCPay Greenfield API key is privileged and must never reach the mobile
# client. Do NOT prefix these with EXPO_PUBLIC_ and do NOT put them in the
# app's root .env. Locally, `supabase functions serve` loads this file.
#
# In production, set them as project secrets instead:
#   supabase secrets set BTCPAY_SERVER_URL=https://btcpay.hachisu.io
#   supabase secrets set BTCPAY_GREENFIELD_API_KEY=<server-side-only-greenfield-key>
#
# The Greenfield API key needs the `btcpay.store.canmodifystoresettings`
# permission (it must be allowed to create stores).

BTCPAY_SERVER_URL=https://btcpay.hachisu.io
BTCPAY_GREENFIELD_API_KEY=

# Auto-injected by Supabase at runtime (no need to set in production):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
